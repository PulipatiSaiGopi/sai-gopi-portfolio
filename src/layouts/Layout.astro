---
import "../styles/global.css";

interface Props {
  title?: string;
}

const { title = "Sai Gopi | AI & Data Science Portfolio" } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <!-- SEO -->
    <meta
      name="description"
      content="Sai Gopi Pulipati — B.Tech Artificial Intelligence & Data Science student building practical machine learning, deep learning, and speech AI projects."
    />

    <meta
      name="keywords"
      content="Sai Gopi Pulipati, Artificial Intelligence, Data Science, Machine Learning, Deep Learning, Python, TensorFlow, Speech AI, AI Portfolio"
    />

    <meta name="author" content="Sai Gopi Pulipati" />

    <meta name="robots" content="index, follow" />

    <!-- Open Graph -->
    <meta
      property="og:title"
      content="Sai Gopi | AI & Data Science Portfolio"
    />

    <meta
      property="og:description"
      content="B.Tech AI & Data Science student building practical machine learning, deep learning, and speech AI projects."
    />

    <meta property="og:type" content="website" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <title>{title}</title>

    <!-- Prevent theme flash -->
    <script is:inline>
      const savedTheme = localStorage.getItem("theme");

      if (savedTheme === "light") {
        document.documentElement.classList.remove("dark");
        document.documentElement.classList.add("light");
      } else {
        document.documentElement.classList.remove("light");
        document.documentElement.classList.add("dark");
      }
    </script>
  </head>

  <body>
    <slot />
  </body>
</html>