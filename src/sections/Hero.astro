<section
  class="relative flex min-h-screen items-center overflow-hidden bg-slate-950 px-6 pb-24 pt-36"
>
  <!-- Background Glow -->
  <div
    class="pointer-events-none absolute left-1/2 top-1/3 h-[500px] w-[500px] -translate-x-1/2 rounded-full bg-cyan-400/10 blur-[140px]"
  ></div>

  <div
    class="pointer-events-none absolute right-[-150px] top-[-100px] h-[400px] w-[400px] rounded-full bg-blue-500/10 blur-[120px]"
  ></div>

  <div class="relative mx-auto w-full max-w-7xl">
    <div class="mx-auto max-w-4xl text-center">

      <!-- Eyebrow -->
      <div
        class="mb-7 inline-flex items-center gap-2 rounded-full border border-cyan-400/20 bg-cyan-400/5 px-4 py-2"
      >
        <span class="relative flex h-2 w-2">
          <span
            class="absolute inline-flex h-full w-full animate-ping rounded-full bg-cyan-400 opacity-75"
          ></span>

          <span
            class="relative inline-flex h-2 w-2 rounded-full bg-cyan-400"
          ></span>
        </span>

        <span
          class="text-xs font-semibold uppercase tracking-[0.25em] text-cyan-300"
        >
          AI & Data Science
        </span>
      </div>

      <!-- Main Heading -->
      <h1
        class="text-5xl font-black leading-[0.95] tracking-[-0.04em] text-white sm:text-6xl md:text-7xl lg:text-8xl"
      >
        Sai Gopi
        <span class="block text-slate-400">
          Pulipati
        </span>
      </h1>

      <!-- Description -->
      <p
        class="mx-auto mt-8 max-w-2xl text-base leading-7 text-slate-400 sm:text-lg sm:leading-8"
      >
        B.Tech Artificial Intelligence & Data Science student passionate about
        machine learning, deep learning, and building intelligent solutions
        that solve real-world problems.
      </p>

      <!-- CTA Buttons -->
      <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a
          href="#projects"
          class="group inline-flex items-center justify-center gap-2 rounded-xl bg-cyan-400 px-7 py-3.5 text-sm font-bold text-slate-950 shadow-lg shadow-cyan-400/10 transition duration-300 hover:-translate-y-1 hover:bg-cyan-300 hover:shadow-cyan-400/20"
        >
          View My Projects

          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="2"
            stroke="currentColor"
            class="h-4 w-4 transition-transform group-hover:translate-x-1"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"
            />
          </svg>
        </a>

        <a
          href="#contact"
          class="inline-flex items-center justify-center rounded-xl border border-white/15 bg-white/[0.03] px-7 py-3.5 text-sm font-semibold text-white transition duration-300 hover:-translate-y-1 hover:border-cyan-400/40 hover:bg-white/[0.06]"
        >
          Let's Connect
        </a>
      </div>

      <!-- Skill Highlights -->
      <div
        class="mt-14 flex flex-wrap items-center justify-center gap-x-6 gap-y-3 text-sm text-slate-500"
      >
        <span class="text-slate-300">Python</span>

        <span class="h-1 w-1 rounded-full bg-cyan-400"></span>

        <span class="text-slate-300">Machine Learning</span>

        <span class="h-1 w-1 rounded-full bg-cyan-400"></span>

        <span class="text-slate-300">Deep Learning</span>

        <span class="h-1 w-1 rounded-full bg-cyan-400"></span>

        <span class="text-slate-300">Data Science</span>
      </div>
    </div>

    <!-- Bottom Scroll Indicator -->
    <div
      class="absolute bottom-[-30px] left-1/2 hidden -translate-x-1/2 flex-col items-center gap-3 text-slate-600 md:flex"
    >
      <span class="text-[10px] font-semibold uppercase tracking-[0.3em]">
        Scroll
      </span>

      <div class="h-10 w-px bg-gradient-to-b from-cyan-400/50 to-transparent"></div>
    </div>
