            <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">Email Me</p>
            <p class="mt-1 font-semibold text-white group-hover:text-blue-300 transition-colors">
              psaipraveen91@gmail.com
            </p>
          </div>
        </a>

        <!-- GitHub Profile Card -->
        <a
          href="https://github.com/PulipatiSaiGopi"
          target="_blank"
