      <!-- Right Contact Form -->
      <div class="rounded-3xl border border-white/10 bg-white/[0.03] p-8 shadow-2xl backdrop-blur-sm lg:col-span-7 sm:p-10">
        <form action="https://formspree.io/f/your-form-id" method="POST" class="space-y-6">
          <div class="grid gap-6 sm:grid-cols-2">
            <div>
              <label for="name" class="block text-xs font-semibold uppercase tracking-wider text-slate-400">
                Your Name
              </label>
              <input
                type="text"
                id="name"
                name="name"
                required
                placeholder="John Doe"
                class="mt-2 w-full rounded-2xl border border-white/10 bg-slate-900/80 px-4 py-3.5 text-sm text-white placeholder-slate-600 transition focus:border-blue-400 focus:outline-none focus:ring-1 focus:ring-blue-400"
              />
            </div>

            <div>
              <label for="email" class="block text-xs font-semibold uppercase tracking-wider text-slate-400">
                Your Email
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                placeholder="john@example.com"
                class="mt-2 w-full rounded-2xl border border-white/10 bg-slate-900/80 px-4 py-3.5 text-sm text-white placeholder-slate-600 transition focus:border-blue-400 focus:outline-none focus:ring-1 focus:ring-blue-400"
              />
            </div>
          </div>

          <div>
            <label for="message" class="block text-xs font-semibold uppercase tracking-wider text-slate-400">
              Message
            </label>
            <textarea
              id="message"
              name="message"
              rows="5"
              required
              placeholder="Hi Sai Gopi, I'd like to talk about..."
              class="mt-2 w-full rounded-2xl border border-white/10 bg-slate-900/80 px-4 py-3.5 text-sm text-white placeholder-slate-600 transition focus:border-blue-400 focus:outline-none focus:ring-1 focus:ring-blue-400"
            ></textarea>
          </div>

          <button
            type="submit"
            class="w-full rounded-2xl bg-gradient-to-r from-blue-500 to-yellow-400 py-4 text-center text-sm font-bold text-slate-950 shadow-lg shadow-blue-500/20 transition duration-300 hover:scale-[1.01] hover:shadow-yellow-400/20"
          >
            Send Message
          </button>
        </form>
      </div>

