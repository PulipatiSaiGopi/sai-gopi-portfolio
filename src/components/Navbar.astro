---
const navItems = [
  { name: 'About', href: '#about' },
  { name: 'Skills', href: '#skills' },
  { name: 'Projects', href: '#projects' },
  { name: 'Education', href: '#education' },
  { name: 'Certifications', href: '#certifications' },
  { name: 'Contact', href: '#contact' },
];
---

<header class="fixed top-0 left-0 right-0 z-50 px-4 py-4">
  <div class="mx-auto max-w-6xl">
    <nav class="flex items-center justify-between rounded-full border border-white/10 bg-slate-950/80 px-6 py-3 shadow-lg backdrop-blur-md">
      
      <!-- Logo -->
      <a href="#" class="group flex items-center gap-2 text-xl font-black tracking-tight text-white">
        <span>Sai</span>
        <span class="h-2 w-2 rounded-full bg-blue-500 transition-transform group-hover:scale-125"></span>
      </a>

      <!-- Navigation Links -->
      <ul class="hidden items-center gap-1 sm:flex md:gap-2">
        {navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class="rounded-full px-4 py-2 text-xs font-semibold text-slate-300 transition duration-200 hover:bg-white/10 hover:text-white md:text-sm"
            >
              {item.name}
            </a>
          </li>
        ))}
      </ul>

      <!-- Action Area: Theme Toggle & Resume -->
      <div class="flex items-center gap-3">
        
        <!-- Light / Dark Toggle Button -->
        <button
          id="theme-toggle"
          aria-label="Toggle Theme"
          type="button"
          class="flex h-9 w-9 items-center justify-center rounded-full border border-slate-300 dark:border-white/20 bg-slate-200 dark:bg-white/10 text-amber-500 transition hover:scale-105"
        >
          <!-- Sun Icon (Shown in Light Mode) -->
          <svg id="theme-toggle-sun" class="h-5 w-5 text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>

          <!-- Moon Icon (Shown in Dark Mode) -->
          <svg id="theme-toggle-moon" class="h-5 w-5 text-yellow-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
          </svg>
        </button>

        <!-- Resume Button -->
        <a
          href="/resume.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center rounded-full bg-gradient-to-r from-blue-500 to-amber-500 px-5 py-2 text-xs font-bold text-slate-950 shadow-md transition duration-300 hover:scale-105 md:text-sm"
        >
          Resume
        </a>

      </div>

    </nav>
  </div>
</header>

<script is:inline>
  function setupThemeToggle() {
    const toggleBtn = document.getElementById('theme-toggle');
    const sunIcon = document.getElementById('theme-toggle-sun');
    const moonIcon = document.getElementById('theme-toggle-moon');

    if (!toggleBtn || !sunIcon || !moonIcon) return;

    function applyTheme(isLight) {
      if (isLight) {
        document.documentElement.classList.add('light');
        sunIcon.style.display = 'block';
        moonIcon.style.display = 'none';
      } else {
        document.documentElement.classList.remove('light');
        sunIcon.style.display = 'none';
        moonIcon.style.display = 'block';
      }
    }

    // Determine initial state
    const savedTheme = localStorage.getItem('theme');
    const isLight = savedTheme === 'light';

    applyTheme(isLight);

    // Remove old listeners to prevent duplicates
    toggleBtn.onclick = () => {
      const currentlyLight = document.documentElement.classList.contains('light');
      const nextLight = !currentlyLight;
      
      applyTheme(nextLight);
      localStorage.setItem('theme', nextLight ? 'light' : 'dark');
    };
  }

  // Run immediately and on DOM load
  setupThemeToggle();
  document.addEventListener('DOMContentLoaded', setupThemeToggle);
  document.addEventListener('astro:page-load', setupThemeToggle);
</script>